PROCUREMIND_DATABASE_URL=sqlite:///./procuremind.db
PROCUREMIND_DEMO_MODE=false
# Generate server-side: python -c "from uuid import uuid4; print(uuid4())"
# PROCUREMIND_DEMO_ACTOR_ID=
# PROCUREMIND_DEMO_DISPLAY_NAME=Demo Analyst
# Role does not automatically grant scopes.
# PROCUREMIND_DEMO_ROLE=ANALYST
# PROCUREMIND_DEMO_SCOPES=["case:read"]
# Backend-only credential: configure in ignored .env or deployment secrets.
# PROCUREMIND_OPENAI_API_KEY=
PROCUREMIND_OPENAI_MODEL=gpt-6.1-sol

# Additional Teguh P0 settings/scopes: see docs/TEGUH_DECISION_HANDOFF.md.
# PROCUREMIND_STORAGE_ROOT=.storage
# PROCUREMIND_OPENAI_TIMEOUT_SECONDS=60

# Local web login. Set the password only in the ignored root .env file.
PROCUREMIND_LOGIN_ENABLED=true
PROCUREMIND_LOGIN_USERNAME=admin
PROCUREMIND_LOGIN_PASSWORD=

# PROPOSED P1.1; enable only after Integration Lead approval and explicit P1 migration.
PROCUREMIND_P1_ENABLED=false

# DC1 classification extension, opt-in per deployment.
PROCUREMIND_DOCUMENT_CLASSIFICATION_ENABLED=false
VITE_DOCUMENT_CLASSIFICATION_ENABLED=false
