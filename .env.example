PROCUREMIND_DATABASE_URL=sqlite:///./procuremind.db
PROCUREMIND_DEMO_MODE=false
# Generate server-side: python -c "from uuid import uuid4; print(uuid4())"
# PROCUREMIND_DEMO_ACTOR_ID=
# PROCUREMIND_DEMO_DISPLAY_NAME=Demo Analyst
# Role does not automatically grant scopes.
# PROCUREMIND_DEMO_ROLE=ANALYST
# PROCUREMIND_OPENAI_API_KEY=
# PROCUREMIND_OPENAI_MODEL=

# PROPOSED operational limits; no confidential PDFs in the demo.
PROCUREMIND_STORAGE_ROOT=.storage
PROCUREMIND_UPLOAD_MAX_BYTES=10485760
PROCUREMIND_PDF_MAX_PAGES=100
PROCUREMIND_PDF_MAX_CHARACTERS=500000
PROCUREMIND_AI_MAX_INPUT_CHARACTERS=100000
PROCUREMIND_OPENAI_PROVIDER=openai
PROCUREMIND_OPENAI_TIMEOUT_SECONDS=60
# P0 demo scopes, only if granted by the backend operator:
# PROCUREMIND_DEMO_SCOPES=["case:read","case:write","case:delete","document:read","document:write","document:delete","analysis:read","analysis:write","finding:read","finding:write","finding:decide","challenge:read","challenge:write","challenge:delete","repair:read","repair:write","repair:delete"]

# Prompt B additionally requires these explicitly granted backend scopes:
# challenge:read, challenge:write, challenge:delete, repair:read, repair:write, repair:delete
